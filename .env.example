# Copie este arquivo para .env.local e substitua pelo valor da sua chave.
# Nunca envie .env.local ao Git.
OPENAI_API_KEY=sk-sua-chave-aqui

# URL completa do webhook de entrada do Google Chat. Mantenha-a somente no backend.
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN
